<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#F0141416"
                android:startColor="#F22A2A2D" />
            <stroke
                android:width="1dp"
                android:color="#38FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#12FFFFFF" />
            <corners android:radius="23dp" />
        </shape>
    </item>
</layer-list>
