<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/detail_backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.66"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_hero_fallback" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_detail_backdrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_detail_bottom_fade" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/content_margin"
                    android:paddingTop="10dp"
                    android:paddingEnd="64dp"
                    android:paddingBottom="10dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/detail_poster_frame"
                        android:layout_width="@dimen/detail_poster_width"
                        android:layout_height="@dimen/detail_poster_height"
                        android:layout_marginEnd="24dp"
                        android:clickable="false"
                        android:clipChildren="true"
                        android:clipToOutline="true"
                        android:focusable="false"
                        app:cardBackgroundColor="#0A0A0C"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="18dp"
                        app:strokeColor="#24FFFFFF"
                        app:strokeWidth="1dp">

                        <com.ch4nhm.tvapp.PosterFadeImageView
                            android:id="@+id/detail_poster"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/poster_placeholder" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/detail_kicker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.05"
                            android:text="TVBox"
                            android:textColor="#CFFFFFFF"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/detail_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:fontFamily="sans-serif-black"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.025"
                            android:maxLines="2"
                            android:shadowColor="#99000000"
                            android:shadowDx="0"
                            android:shadowDy="3"
                            android:shadowRadius="12"
                            android:textColor="@color/white"
                            android:textSize="36sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/detail_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:textColor="#D6D6DB"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/detail_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="3dp"
                            android:maxLines="2"
                            android:textColor="#C7C7CC"
                            android:textSize="17sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/detail_play"
                                android:layout_width="wrap_content"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_button_secondary"
                                android:clickable="true"
                                android:drawableStart="@drawable/ic_play_light"
                                android:drawablePadding="11dp"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:minWidth="152dp"
                                android:paddingStart="30dp"
                                android:paddingEnd="30dp"
                                android:textColor="@color/white"
                                android:textSize="17sp" />

                            <TextView
                                android:id="@+id/detail_keep"
                                android:layout_width="wrap_content"
                                android:layout_height="52dp"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/bg_button_secondary"
                                android:clickable="true"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:minWidth="116dp"
                                android:paddingStart="26dp"
                                android:paddingEnd="26dp"
                                android:text="收藏"
                                android:textColor="@color/white"
                                android:textSize="17sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@color/bg_base"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/content_margin"
                android:paddingEnd="@dimen/content_margin">

                <TextView
                    style="@style/TextAppearance.TvApp.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选集" />

                <LinearLayout
                    android:id="@+id/play_group_row"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="30dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/play_group_list"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:focusable="false"
                        android:overScrollMode="never"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:scrollbars="none" />
                </LinearLayout>

                <TextView
                    android:id="@+id/detail_source"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />
            </LinearLayout>

            <com.ch4nhm.tvapp.ClippedRecyclerView
                android:id="@+id/episode_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/bg_base"
                android:clipChildren="true"
                android:clipToPadding="false"
                android:focusable="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/content_margin"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/content_margin"
                android:paddingBottom="28dp"
                android:scrollbars="none" />
    </LinearLayout>
</FrameLayout>
