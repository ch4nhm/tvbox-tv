<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:clipChildren="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:focusable="false"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:use_controller="false" />

    <FrameLayout
        android:id="@+id/player_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:id="@+id/player_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_player_scrim"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:id="@+id/player_top_panel"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_gravity="top"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="32dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:text="正在播放"
                    android:textColor="#A8FFFFFF"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/player_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="24sp" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/player_bottom_panel"
            android:layout_width="860dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_player_bottom_panel"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="14dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/player_episode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/player_control_row"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="4dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/player_previous"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_player_control"
                    android:clickable="true"
                    android:contentDescription="上一集"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_previous_episode"
                    android:tint="@color/player_control_icon" />

                <ImageView
                    android:id="@+id/player_play"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_player_primary_control"
                    android:clickable="true"
                    android:contentDescription="@string/hero_play"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="16dp"
                    android:src="@drawable/ic_pause_light"
                    android:tint="@color/player_primary_icon" />

                <ImageView
                    android:id="@+id/player_next"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_player_control"
                    android:clickable="true"
                    android:contentDescription="下一集"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_next_episode"
                    android:tint="@color/player_control_icon" />

                <TextView
                    android:id="@+id/player_time"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="00:00"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <SeekBar
                    android:id="@+id/player_seek"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:progressBackgroundTint="@color/progress_track"
                    android:progressTint="?attr/tvAccent"
                    android:thumbTint="?attr/tvAccent" />

                <TextView
                    android:id="@+id/player_duration"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:text="00:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/player_state_panel"
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_player_state"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="38dp"
        android:paddingEnd="48dp"
        android:paddingBottom="38dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/player_state_progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="?attr/tvAccent" />

        <TextView
            android:id="@+id/player_state_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="正在解析播放地址"
            android:textColor="@color/text_primary"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/player_state_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:maxLines="4"
            android:text="正在连接当前片源，请稍候…"
            android:textColor="@color/text_secondary"
            android:textSize="17sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/player_state_action"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="208dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="打开网盘中心"
            android:textColor="?attr/tvAccentOn"
            android:textSize="18sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
