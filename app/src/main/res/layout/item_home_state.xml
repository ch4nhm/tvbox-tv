<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:minHeight="300dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/content_margin"
    android:paddingTop="52dp"
    android:paddingEnd="@dimen/content_margin"
    android:paddingBottom="64dp">

    <ProgressBar
        android:id="@+id/home_state_progress"
        style="?android:attr/progressBarStyle"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:indeterminateTint="?attr/tvAccent" />

    <TextView
        android:id="@+id/home_state_title"
        style="@style/TextAppearance.TvApp.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="正在连接片源" />

    <TextView
        android:id="@+id/home_state_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:maxLines="4"
        android:text="首次加载可能需要几秒，正在准备海报、分类与播放线路。"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/home_state_primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="154dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="重新加载"
            android:textColor="?attr/tvAccentOn"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/home_state_secondary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="154dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="打开设置"
            android:textColor="@color/white"
            android:textSize="17sp" />
    </LinearLayout>
</LinearLayout>
