<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/home_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:overScrollMode="never"
        android:paddingStart="@dimen/content_margin"
        android:paddingTop="@dimen/nav_height"
        android:paddingEnd="@dimen/content_margin"
        android:paddingBottom="40dp"
        android:scrollbars="none" />

    <FrameLayout
        android:id="@+id/main_category_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_base"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="@dimen/nav_height"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="true">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/main_category_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="true"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/content_margin"
                android:paddingTop="20dp"
                android:paddingEnd="@dimen/content_margin"
                android:paddingBottom="36dp"
                android:scrollbars="none" />

            <LinearLayout
                android:id="@+id/main_category_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/main_category_progress"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:indeterminateTint="?attr/tvAccent" />

                <TextView
                    android:id="@+id/main_category_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="正在加载内容…"
                    android:textColor="@color/text_secondary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/main_category_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="152dp"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:text="重试"
                    android:textColor="?attr/tvAccentOn"
                    android:textSize="17sp"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/main_category_filter_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_category_filter_overlay"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="24dp"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"
                    android:text="筛选"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/main_category_filter_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_filter_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="72dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="清除"
                    android:textColor="@color/filter_chip_text"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/main_category_filter_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/main_library_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="@dimen/nav_height"
        android:visibility="gone">

        <ViewStub
            android:id="@+id/library_view_stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout="@layout/activity_library" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/main_live_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="@dimen/nav_height"
        android:visibility="gone">

        <ViewStub
            android:id="@+id/live_view_stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout="@layout/activity_live" />
    </FrameLayout>

    <View
        android:id="@+id/nav_backdrop"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_height"
        android:alpha="0"
        android:background="@color/bg_base" />

    <include layout="@layout/view_top_nav" />

</FrameLayout>
