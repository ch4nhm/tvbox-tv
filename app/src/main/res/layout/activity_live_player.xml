<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/live_player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/live_player_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:use_controller="false" />

    <FrameLayout
        android:id="@+id/live_player_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_live_player_vignette"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="44dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="180dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_live_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:text="正在直播"
                    android:textColor="#B8FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/live_player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="24sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="44dp"
            android:background="@drawable/bg_live_badge"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:minWidth="76dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="LIVE"
            android:textColor="#08080A"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/live_player_bottom_panel"
            android:layout_width="860dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginStart="44dp"
            android:layout_marginEnd="44dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_player_bottom_panel"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="22dp"
            android:paddingEnd="30dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/live_player_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:textColor="#B8FFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/live_player_channel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="34sp" />

            <LinearLayout
                android:id="@+id/live_player_control_row"
                android:layout_width="match_parent"
                android:layout_height="78dp"
                android:layout_marginTop="6dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/live_player_previous"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_player_control"
                    android:clickable="true"
                    android:contentDescription="上一个频道"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="15dp"
                    android:src="@drawable/ic_previous_episode"
                    android:tint="@color/player_control_icon" />

                <ImageView
                    android:id="@+id/live_player_play"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="22dp"
                    android:background="@drawable/bg_player_primary_control"
                    android:clickable="true"
                    android:contentDescription="暂停直播"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="20dp"
                    android:src="@drawable/ic_pause_light"
                    android:tint="@color/player_primary_icon" />

                <ImageView
                    android:id="@+id/live_player_next"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="22dp"
                    android:background="@drawable/bg_player_control"
                    android:clickable="true"
                    android:contentDescription="下一个频道"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="15dp"
                    android:src="@drawable/ic_next_episode"
                    android:tint="@color/player_control_icon" />

                <TextView
                    android:id="@+id/live_player_line"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_button_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="136dp"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:text="切换线路"
                    android:textColor="@color/white"
                    android:textSize="17sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="左右键切换频道"
                    android:textColor="#A8FFFFFF"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/live_player_state_panel"
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_live_player_state"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingTop="38dp"
            android:paddingEnd="48dp"
            android:paddingBottom="38dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/live_player_state_progress"
                style="?android:attr/progressBarStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="?attr/tvAccent" />

            <TextView
                android:id="@+id/live_player_state_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="正在连接直播"
                android:textColor="@color/text_primary"
            android:textSize="30sp" />

            <TextView
                android:id="@+id/live_player_state_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:maxLines="4"
                android:text="正在准备频道画面…"
                android:textColor="@color/text_secondary"
            android:textSize="17sp"
            android:visibility="gone" />

            <TextView
                android:id="@+id/live_player_state_action"
                android:layout_width="wrap_content"
            android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="184dp"
                android:paddingStart="30dp"
                android:paddingEnd="30dp"
                android:text="重试"
                android:textColor="?attr/tvAccentOn"
            android:textSize="18sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
