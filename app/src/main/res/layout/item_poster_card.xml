<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <com.ch4nhm.tvapp.RoundedFrameLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_poster_surface"
        android:clipChildren="true"
        android:clipToOutline="true"
        android:clickable="false"
        android:focusable="false"
        app:surfaceAspectRatio="1.5"
        app:surfaceCornerRadius="@dimen/card_radius">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/poster_placeholder" />

            <TextView
                android:id="@+id/source"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_source_chip"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxWidth="108dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:visibility="gone" />

            <View
                android:id="@+id/focus_outline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="@drawable/bg_focus_outline"
                android:importantForAccessibility="no" />

        </FrameLayout>

    </com.ch4nhm.tvapp.RoundedFrameLayout>

    <TextView
        android:id="@+id/title"
        style="@style/TextAppearance.TvApp.CardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textSize="18sp"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/meta"
        style="@style/TextAppearance.TvApp.CardMeta"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:visibility="gone" />

</LinearLayout>
