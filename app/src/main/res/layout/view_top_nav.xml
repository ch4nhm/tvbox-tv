<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_height"
    android:background="@drawable/bg_top_scrim"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingStart="@dimen/content_margin"
    android:paddingEnd="@dimen/content_margin">

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_logo" />

    <TextView
        android:id="@+id/nav_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/app_name"
        android:textColor="@color/white"
        android:textSize="22sp" />

    <FrameLayout
        android:id="@+id/nav_tabs"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/nav_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
            android:id="@+id/nav_home"
            style="@style/TextAppearance.TvApp.Nav"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/bg_nav_text_focus"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/nav_home" />

        <TextView
            android:id="@+id/nav_movie"
            style="@style/TextAppearance.TvApp.Nav"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_nav_text_focus"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/nav_movie" />

        <TextView
            android:id="@+id/nav_tv"
            style="@style/TextAppearance.TvApp.Nav"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_nav_text_focus"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/nav_tv" />

        <TextView
            android:id="@+id/nav_variety"
            style="@style/TextAppearance.TvApp.Nav"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_nav_text_focus"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/nav_variety" />

        <TextView
            android:id="@+id/nav_anime"
            style="@style/TextAppearance.TvApp.Nav"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_nav_text_focus"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/nav_anime" />

        <TextView
            android:id="@+id/nav_live"
            style="@style/TextAppearance.TvApp.Nav"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_nav_text_focus"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/nav_live" />

        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/action_source"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_source_pill"
        android:clickable="true"
        android:drawableStart="@drawable/ic_source"
        android:drawablePadding="8dp"
        android:drawableTint="@color/nav_text"
        android:ellipsize="end"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxWidth="180dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:text="片源"
        android:textColor="@color/nav_text"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/action_search"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_icon_focus"
        android:clickable="true"
        android:contentDescription="@string/search"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="12dp"
        android:src="@drawable/ic_search" />

    <ImageView
        android:id="@+id/nav_mine"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_icon_focus"
        android:clickable="true"
        android:contentDescription="@string/nav_mine"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="14dp"
        android:src="@drawable/ic_history"
        android:tint="@color/nav_text" />

    <ImageView
        android:id="@+id/action_settings"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_icon_focus"
        android:clickable="true"
        android:contentDescription="@string/settings"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="12dp"
        android:src="@drawable/ic_settings" />

</LinearLayout>
