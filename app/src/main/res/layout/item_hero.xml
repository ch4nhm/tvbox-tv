<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/hero_height"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/hero_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.9"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_hero_fallback" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_ambient" />

    <View
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_hero_bottom_fade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/nav_height"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/content_margin"
        android:paddingTop="62dp"
        android:paddingEnd="84dp">

        <LinearLayout
            android:id="@+id/hero_copy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingEnd="52dp">

            <TextView
                android:id="@+id/hero_kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:text="TVBox 精选"
                android:textColor="#BFFFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:maxLines="2"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="12"
                android:text="@string/hero_title"
                android:textColor="@color/white"
                android:textSize="42sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/hero_title_en"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/hero_title_en"
                    android:textColor="#D1D1D6"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/hero_source"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_source_chip"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxWidth="160dp"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:singleLine="true"
                    android:text="TVBox"
                    android:textColor="#D1D1D6"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/hero_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:lineSpacingExtra="4dp"
                android:maxLines="2"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:text="@string/hero_desc"
                android:textColor="#BFFFFFFF"
                android:textSize="15sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hero_play"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_play"
                    android:drawablePadding="11dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="152dp"
                    android:nextFocusRight="@id/hero_detail"
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp"
                    android:text="播放"
                    android:textColor="@color/nav_active_text"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/hero_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_button_secondary"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_info"
                    android:drawablePadding="10dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="124dp"
                    android:nextFocusLeft="@id/hero_play"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="详情"
                    android:textColor="@color/white"
                    android:textSize="17sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/hero_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot_1"
                    android:layout_width="22dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_dot_active" />

                <View
                    android:id="@+id/dot_2"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_dot_inactive" />

                <View
                    android:id="@+id/dot_3"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_dot_inactive" />

                <View
                    android:id="@+id/dot_4"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_dot_inactive" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/hero_poster_frame"
            android:layout_width="@dimen/hero_poster_width"
            android:layout_height="@dimen/hero_poster_height"
            android:layout_marginEnd="44dp"
            android:clipChildren="true"
            android:clipToOutline="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/hero_detail"
            app:cardBackgroundColor="#0A0A0C"
            app:cardCornerRadius="16dp"
            app:cardElevation="16dp"
            app:strokeColor="#24FFFFFF"
            app:strokeWidth="1dp">

            <com.ch4nhm.tvapp.PosterFadeImageView
                android:id="@+id/hero_poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/hero_title"
                android:scaleType="centerCrop"
                android:src="@drawable/poster_placeholder" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</FrameLayout>
